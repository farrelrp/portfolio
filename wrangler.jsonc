{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reksa-portfolio",
  "compatibility_date": "2026-11-01",
  // Personal account (farrelreksa@gmail.com), which holds the rrreksa.com zone.
  "account_id": "aa4b79e8dbf7e56d1950eba6c246faab",
  // Deploy creates the DNS record for the custom domain.
  "routes": [{ "pattern": "rrreksa.com", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
