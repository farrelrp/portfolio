---
// The three-finger salute from The Hunger Games, as it shows up at protests
// in Indonesia, drawn as pixel line art: index, middle and ring
// fingers up, thumb across the palm holding the curled pinky. One "#" is one
// pixel.
const grid = `
..........##..........
.........#..#.........
........#....#.##.....
.....##.#....##..#....
....#..##....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#....#....#....#...
...#..............#...
...#........########..
...#.....#####......#.
...#..###.....#.....#.
....##........######..
..#..........#....#...
..#.......###.....#...
..#....###........#...
..#..##...........#...
...#..............#...
....#............#....
.....#..........#.....
......#........#......
......#........#......
......#........#......
......#........#......
`
  .trim()
  .split("\n");

const w = grid[0].length;
const h = grid.length;
let d = "";
grid.forEach((row, y) => {
  for (const m of row.matchAll(/#+/g)) d += `M${m.index} ${y}h${m[0].length}v1h-${m[0].length}z`;
});
---

<figure class="salute" title="three fingers up">
  <svg viewBox={`0 0 ${w} ${h}`} width={w * 2} height={h * 2} shape-rendering="crispEdges" role="img" aria-label="Three-finger salute">
    <path fill="currentColor" d={d} />
  </svg>
</figure>

<style>
  .salute {
    margin: 3rem auto 0;
    padding-bottom: calc(3rem + env(safe-area-inset-bottom));
    display: flex;
    justify-content: center;
    color: var(--faint);
    transition: color 0.2s ease;
  }
  .salute:hover {
    color: var(--fg);
  }
  @media print {
    .salute {
      display: none;
    }
  }
</style>
