---
// "The bitter lesson": a short idea paired with the historical pattern
// (chess, speech, vision, Go -> now). Dithered bars are drawn by src/scripts/bitter.ts.

const ICONS: Record<string, string> = {
  chess: `
....###....
...#####...
..##.#.##..
.########..
..####.##..
....####...
...#####...
..#######..
..#######..
.#########.
.#########.`,
  speech: `
.....#.....
.....#.....
...#.#.#...
...#.#.#...
.#.#.#.#.#.
.#.#.#.#.#.
.#.#.#.#.#.
...#.#.#...
...#.#.#...
.....#.....
.....#.....`,
  vision: `
...........
...........
...#####...
..##...##..
.##.###.##.
##.##.##.##
.##.###.##.
..##...##..
...#####...
...........
...........`,
  go: `
..#.....#..
.###...#.#.
#####.#...#
.###...#.#.
..#.....#..
...........
..#.....#..
.#.#...###.
#...#.#####
.#.#...###.
..#.....#..`,
  now: `
.....#.....
.....#.....
....###....
...#####...
..#######..
###########
..#######..
...#####...
....###....
.....#.....
.....#.....`,
};

function gridToPath(raw: string) {
  const lines = raw.trim().split("\n");
  let d = "";
  lines.forEach((row, y) => {
    for (const m of row.matchAll(/#+/g)) d += `M${m.index} ${y}h${m[0].length}v1h-${m[0].length}z`;
  });
  return d;
}

const eras = [
  {
    icon: "chess",
    year: "1997",
    field: "chess",
    old: "grandmaster rules & opening books",
    won: "deep search",
    scale: 16,
  },
  {
    icon: "speech",
    year: "2010s",
    field: "speech",
    old: "phoneme & acoustic grammars",
    won: "end-to-end nets",
    scale: 34,
  },
  {
    icon: "vision",
    year: "2012",
    field: "vision",
    old: "hand-crafted edge detectors",
    won: "convnets on gpus",
    scale: 56,
  },
  {
    icon: "go",
    year: "2017",
    field: "go",
    old: "centuries of human strategy",
    won: "self-play + search",
    scale: 78,
  },
  {
    icon: "now",
    year: "now",
    field: "products",
    old: "prompt hacks & model workarounds",
    won: "systems that scale",
    scale: 100,
    current: true,
  },
];
---

<section class="bitter" id="bitter" aria-labelledby="bitter-h" data-bitter>
  <div class="bitter-text">
    <p class="bitter-eyebrow"><span aria-hidden="true">*</span> on building with ai</p>
    <h2 id="bitter-h">The bitter lesson</h2>
    <p>
      Rich Sutton wrote about a pattern that keeps repeating in AI. Hand-coded tricks win early on, then get passed once
      there's enough compute for a general method to learn the problem itself.
    </p>
    <p>
      Happened in chess, Go, speech and vision. It stings because the clever parts people spent years crafting are
      usually the first things thrown out.
    </p>
    <p class="bitter-take">
      I try to keep that in mind when building with AI. Most workarounds for today's model quirks won't age well. I'd
      rather work on the parts that get better when the next model drops.
    </p>
  </div>

  <figure
    class="bitter-figure"
    aria-label="Five eras of The Bitter Lesson: hand-crafted rules repeatedly replaced by general methods as compute scales."
  >
    <ol class="bitter-list">
      {
        eras.map((e) => (
          <li class:list={["bitter-row", { "bitter-now": e.current }]}>
            <div class="bitter-meta">
              <svg
                class="bitter-icon"
                viewBox="0 0 11 11"
                width="14"
                height="14"
                shape-rendering="crispEdges"
                aria-hidden="true"
              >
                <path fill="currentColor" d={gridToPath(ICONS[e.icon])} />
              </svg>
              <span class="bitter-field">{e.field}</span>
              <span class="bitter-year">{e.year}</span>
            </div>

            <div class="bitter-shift">
              <span class="bitter-old">{e.old}</span>
              <span class="bitter-arrow" aria-hidden="true">→</span>
              <span class="bitter-won">{e.won}</span>
            </div>

            <div class="bitter-bar-wrap" aria-hidden="true">
              <div class="bitter-bar" style={`width: ${e.scale}%`}>
                <canvas data-bar data-w={Math.max(24, Math.round(e.scale * 1.4))} data-h="5"></canvas>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </figure>
</section>

<script>
  import { mountBitter } from "../scripts/bitter";
  const el = document.querySelector<HTMLElement>("[data-bitter]");
  if (el) mountBitter(el);
</script>

<style>
  .bitter {
    max-width: 66rem;
    margin: 0 auto;
    padding: 7.5rem var(--gutter) 2rem;
    scroll-margin-top: var(--bar);
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }
  .bitter-eyebrow {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .bitter-eyebrow span {
    color: var(--faint);
  }
  h2 {
    margin: 0.6rem 0 1.25rem;
    font-size: clamp(2.25rem, 4.6vw, 3.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .bitter-text p:not(.bitter-eyebrow) {
    color: var(--fg-2);
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .bitter-text p + p {
    margin-top: 0.9rem;
  }
  .bitter-text p.bitter-take {
    margin-top: 1.25rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--fg);
    color: var(--fg);
  }

  .bitter-figure {
    margin: 0;
  }
  .bitter-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bitter-row {
    padding: 0.9rem 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.45rem 1rem;
    align-items: baseline;
  }
  .bitter-row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .bitter-now {
    border-top-color: var(--border);
    padding: 0.95rem 0.75rem;
    margin: 0.15rem -0.75rem 0;
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    border-radius: 4px;
  }
  .bitter-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .bitter-icon {
    flex: none;
    color: var(--muted);
  }
  .bitter-now .bitter-icon {
    color: var(--fg);
  }
  .bitter-field {
    color: var(--fg);
    font-weight: 500;
  }
  .bitter-year {
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .bitter-shift {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .bitter-old {
    color: var(--muted);
    text-decoration: line-through;
    text-decoration-color: var(--faint);
  }
  .bitter-arrow {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .bitter-won {
    color: var(--fg);
    font-weight: 500;
  }
  .bitter-bar-wrap {
    grid-column: 2;
    height: 5px;
    background: var(--rule);
    overflow: hidden;
  }
  .bitter-bar {
    height: 100%;
  }
  .bitter-bar canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  @media (max-width: 859px) {
    .bitter {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      padding-top: 5rem;
    }
  }
  @media (max-width: 560px) {
    .bitter-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .bitter-bar-wrap {
      grid-column: 1;
    }
  }
</style>
