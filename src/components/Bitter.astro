---
// "The bitter lesson": a short idea with a chart, between the hero and the
// rest of the page. The chart is drawn by src/scripts/bitter.ts.
---

<section class="bitter" id="bitter" aria-labelledby="bitter-h" data-bitter>
  <div class="bitter-text">
    <p class="bitter-eyebrow"><span aria-hidden="true">*</span> on building with ai</p>
    <h2 id="bitter-h">The bitter lesson</h2>
    <p>
      Rich Sutton wrote about a pattern that keeps repeating in AI. Hand-coded tricks win early on, then get passed once
      there's enough compute for a general method to learn the problem itself.
    </p>
    <p>
      Happened in chess, Go, speech and vision. It stings because the clever parts people spent years crafting are
      usually the first things thrown out.
    </p>
    <p class="bitter-take">
      I try to keep that in mind when building with AI. Most workarounds for today's model quirks won't age well. I'd
      rather work on the parts that get better when the next model drops.
    </p>
  </div>

  <figure class="bitter-figure">
    <p class="bitter-y" aria-hidden="true">how well it works</p>
    <div class="bitter-stage">
      <canvas
        role="img"
        aria-label="A chart. Knowledge built in by hand rises quickly and levels off. A general method that scales with compute starts lower, crosses it, and keeps rising."
      ></canvas>
      <span class="bitter-label" data-label="hand" aria-hidden="true">built by hand</span>
      <span class="bitter-label" data-label="general" aria-hidden="true">learning + search</span>
      <span class="bitter-label" data-label="cross" aria-hidden="true">crossover</span>
    </div>
    <label class="bitter-x">
      <span>compute</span>
      <input type="range" min="0" max="1000" value="0" />
      <span aria-hidden="true">→</span>
    </label>
    <p class="bitter-caption" data-caption></p>
  </figure>
</section>

<script>
  import { mountBitter } from "../scripts/bitter";
  const el = document.querySelector<HTMLElement>("[data-bitter]");
  if (el) mountBitter(el);
</script>

<style>
  .bitter {
    max-width: 66rem;
    margin: 0 auto;
    padding: 7.5rem var(--gutter) 2rem;
    scroll-margin-top: var(--bar);
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }
  .bitter-eyebrow {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .bitter-eyebrow span {
    color: var(--faint);
  }
  h2 {
    margin: 0.6rem 0 1.25rem;
    font-size: clamp(2.25rem, 4.6vw, 3.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .bitter-text p:not(.bitter-eyebrow) {
    color: var(--fg-2);
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }
  .bitter-text p + p {
    margin-top: 0.9rem;
  }
  .bitter-text p.bitter-take {
    margin-top: 1.25rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--fg);
    color: var(--fg);
  }

  .bitter-figure {
    margin: 0;
  }
  .bitter-y {
    margin-bottom: 0.5rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .bitter-stage {
    position: relative;
  }
  canvas {
    display: block;
    width: 100%;
    aspect-ratio: 220 / 120;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  .bitter-label {
    position: absolute;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: var(--bg);
    font-family: var(--mono);
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--fg);
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .bitter-label[data-side="above"] {
    margin-top: -1.65rem;
  }
  .bitter-label[data-side="below"] {
    margin-top: 0.5rem;
  }
  .bitter-label[data-label="hand"] {
    color: var(--muted);
  }
  .bitter-label[data-label="cross"] {
    translate: -50% 0;
    margin: 0.6rem 0 0;
    padding: 0;
    background: none;
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .bitter-x {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  input[type="range"] {
    flex: 1;
    height: 2.75rem;
    margin: 0;
    background: none;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--border);
  }
  input[type="range"]::-moz-range-track {
    height: 2px;
    background: var(--border);
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 14px;
    height: 14px;
    margin-top: -6px;
    border-radius: 50%;
    background: var(--fg);
    border: 0;
    transition: transform 0.12s ease;
  }
  input[type="range"]::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--fg);
    border: 0;
  }
  input[type="range"]:active::-webkit-slider-thumb {
    transform: scale(1.2);
  }
  input[type="range"]:focus-visible {
    outline: none;
  }
  input[type="range"]:focus-visible::-webkit-slider-thumb {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  input[type="range"]:focus-visible::-moz-range-thumb {
    outline: 2px solid var(--fg);
    outline-offset: 3px;
  }
  .bitter-caption {
    min-height: 1.6em;
    margin-top: 0.25rem;
    font-size: 1rem;
    color: var(--fg);
    text-wrap: pretty;
  }

  @media (max-width: 859px) {
    .bitter {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      padding-top: 5rem;
    }
    .bitter-caption {
      min-height: 3.2em;
    }
  }
</style>
