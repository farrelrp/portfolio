---
import type { Entry } from "../data/profile";

interface Props {
  id: string;
  entries: Entry[];
}
const { id, entries } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}><span aria-hidden="true">*</span> {id}</h2>
  <ul class="rows">
    {
      entries
        .filter((e) => !e.cvOnly)
        .map((e) => (
          <li class="row" id={e.id}>
            <span class="row-date">{e.date}</span>
            <div class="row-body">
              <p class="row-head">
                {e.logo ? (
                  <img class="mark" src={`/logos/${e.logo}`} alt="" width="20" height="20" loading="lazy" />
                ) : (
                  id === "work" && <span class="mark mark-text" aria-hidden="true">{e.title[0]}</span>
                )}
                {e.href ? (
                  <a href={e.href} target="_blank" rel="noopener">
                    {e.title}
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="row-title">{e.title}</span>
                )}
              </p>
              {e.role && <p class="row-role">{e.role}</p>}
              <p class="row-summary">{e.summary}</p>
              {(e.badges || e.links) && (
                <ul class="badges">
                  {e.badges?.map((bd) => (
                    <li>
                      {bd.target ? (
                        <button type="button" class={`badge badge-${bd.kind}`} data-jump={bd.target} title="Jump to award">
                          <span class="badge-star" aria-hidden="true">*</span>
                          {bd.label}
                          <span class="badge-arrow" aria-hidden="true">↓</span>
                        </button>
                      ) : (
                        <span class={`badge badge-${bd.kind}`}>
                          {bd.kind === "award" && <span class="badge-star" aria-hidden="true">*</span>}
                          {bd.label}
                        </span>
                      )}
                    </li>
                  ))}
                  {e.links?.map((l) => (
                    <li>
                      <a class="badge badge-link" href={l.href} target="_blank" rel="noopener">
                        {l.label === "paper" ? (
                          <svg class="badge-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M4 2.5h5.5L12.5 5.5v8h-8.5z" />
                            <path d="M9.5 2.5v3h3" />
                            <path d="M6 8.5h4M6 11h3" />
                          </svg>
                        ) : l.label === "slides" ? (
                          <svg class="badge-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2" y="3" width="12" height="8" rx="1" />
                            <path d="M8 11v2.5M5.5 13.5h5" />
                          </svg>
                        ) : (
                          <svg class="badge-icon" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6.8 9.2l2.4-2.4M5.5 7L4 8.5a2.5 2.5 0 0 0 3.5 3.5L9 10.5M10.5 9L12 7.5A2.5 2.5 0 0 0 8.5 4L7 5.5" />
                          </svg>
                        )}
                        {l.label}
                        <span class="arrow" aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
    }
  </ul>
</section>
