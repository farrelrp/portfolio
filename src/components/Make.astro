---
// "What to build": the second idea, under the bitter lesson. A full-width
// corridor of pixel tiles that the page scroll flies through, with the
// headline at its vanishing point. Drawn by src/scripts/make.ts.
---

<section class="make" id="make" aria-labelledby="make-h" data-make>
  <div class="make-stage">
    <canvas aria-hidden="true"></canvas>
    <div class="make-title">
      <p class="make-eyebrow"><span aria-hidden="true">*</span> on what to build</p>
      <h2 id="make-h">Building is the easy part now.</h2>
    </div>
  </div>

  <div class="make-text">
    <p>I grew up hearing the future belonged to people who could code, because building was the hard part.</p>
    <p>It isn't anymore. An idea goes from a note on my phone to something people can use in an afternoon.</p>
    <p class="make-take">Now the hard part is figuring out what's worth making, and who actually needs it.</p>
  </div>
</section>

<script>
  import { mountMake } from "../scripts/make";
  const el = document.querySelector<HTMLElement>("[data-make]");
  if (el) mountMake(el);
</script>

<style>
  .make {
    padding-top: 6rem;
    scroll-margin-top: var(--bar);
  }
  .make-stage {
    position: relative;
    height: clamp(24rem, 82svh, 48rem);
    display: grid;
    place-items: center;
    overflow: hidden;
    /* The band fades into the page above and below it. */
    mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-image: linear-gradient(transparent, #000 14%, #000 86%, transparent);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }
  .make-title {
    position: relative;
    padding: 4rem var(--gutter);
    text-align: center;
    /* A soft patch of page colour keeps the words clear of the tiles. */
    background: radial-gradient(ellipse at center, var(--bg) 62%, transparent 100%);
    pointer-events: none;
  }
  .make-eyebrow {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .make-eyebrow span {
    color: var(--faint);
  }
  h2 {
    max-width: 9em;
    margin: 0.8rem auto 0;
    font-size: clamp(2.5rem, 6.4vw, 5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .make-text {
    max-width: 44rem;
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 2rem;
  }
  .make-text p {
    color: var(--fg-2);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  .make-text p + p {
    margin-top: 1rem;
  }
  .make-text p.make-take {
    color: var(--fg);
  }

  @media (max-width: 859px) {
    .make {
      padding-top: 4rem;
    }
  }
</style>
