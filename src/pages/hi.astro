---
import Base from "../layouts/Base.astro";
import { profile } from "../data/profile";
import { hi, recommend, albums, manga, type Shelf } from "../data/hi";

const year = new Date().getFullYear();
---

<Base title="reksa" description="Albums, manga, a duck game and whatever I'm recommending this week." egg>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar">
    <div class="bar-left">
      <a class="bar-name" href="/">{profile.short}</a>
      <nav class="bar-switch" aria-label="Pages">
        <a href="/">work</a>
        <span aria-hidden="true">/</span>
        <a aria-current="page" href="/hi">me</a>
      </nav>
    </div>
    <div class="bar-right">
      <span class="bar-clock" title="Time in Jakarta">jkt <span data-clock>--:--</span></span>
      <button type="button" class="chip chip-icon" data-action="theme" aria-label="Toggle theme" title="Toggle theme [t]">
        <span class="theme-dot" aria-hidden="true"></span>
      </button>
    </div>
  </header>

  <main class="hi" id="main">
    <section class="hi-hero">
      <img class="portrait" src="/hi/portrait.jpg" alt="Reksa leaning on a railing outside, city buildings behind" width="720" height="959" />
      <div class="hi-intro">
        <p class="eyebrow">{hi.location}</p>
        <h1><span class="hl"><canvas aria-hidden="true" data-highlight></canvas>{hi.intro}</span></h1>
        <p class="lede">
          This is the part that won't fit on <a class="lede-link" href="/">the other page<span class="arrow" aria-hidden="true">↗</span></a>.
          Here's what I've been into.
        </p>
        <nav class="links" aria-label="Elsewhere">
          {
            hi.links.map((l) => (
              <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel="noopener">
                {l.label}
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
      </div>
    </section>

    <section class="section" aria-labelledby="rec-h">
      <div class="section-head">
        <h2 id="rec-h"><span aria-hidden="true">*</span> recommending right now</h2>
        <span class="section-hint" aria-hidden="true">tap covers for colour</span>
      </div>
      <div class="rec">
        <button
          type="button"
          class="cover rec-cover"
          data-reveal
          aria-pressed="false"
          aria-label={`Toggle colour cover for ${recommend.title}`}
        >
          <canvas data-dither={recommend.cover} aria-hidden="true"></canvas>
          <img src={recommend.cover} alt="" loading="lazy" />
        </button>
        <div class="rec-body">
          <p class="rec-kind">{recommend.kind}</p>
          <a class="rec-link" href={recommend.href} target="_blank" rel="noopener">
            <p class="rec-title">{recommend.title}</p>
            <p class="rec-by">{recommend.by}</p>
            <p class="rec-cta">{recommend.cta} <span class="arrow" aria-hidden="true">↗</span></p>
          </a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="albums-h">
      <h2 id="albums-h"><span aria-hidden="true">*</span> albums</h2>
      <ul class="shelf shelf-albums">
        {albums.map((a: Shelf) => (
          <li>
            <button
              type="button"
              class="cover"
              data-reveal
              aria-pressed="false"
              aria-label={`Toggle colour cover for ${a.title}`}
            >
              <canvas data-dither={a.cover} aria-hidden="true"></canvas>
              <img src={a.cover} alt="" loading="lazy" />
            </button>
            <p class="shelf-title">{a.title}</p>
            <p class="shelf-by">{a.by}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="manga-h">
      <h2 id="manga-h"><span aria-hidden="true">*</span> manga</h2>
      <ul class="shelf shelf-manga">
        {manga.map((m: Shelf) => (
          <li>
            <button
              type="button"
              class="cover cover-tall"
              data-reveal
              aria-pressed="false"
              aria-label={`Toggle colour cover for ${m.title}`}
            >
              <canvas data-dither={m.cover} aria-hidden="true"></canvas>
              <img src={m.cover} alt="" loading="lazy" />
            </button>
            <a href={m.href} target="_blank" rel="noopener" class="shelf-meta">
              <p class="shelf-title">{m.title}<span class="arrow" aria-hidden="true">↗</span></p>
              <p class="shelf-by">{m.by}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="game-h">
      <h2 id="game-h"><span aria-hidden="true">*</span> duck</h2>
      <div
        class="runner"
        data-runner
        data-state="idle"
        tabindex="0"
        role="button"
        aria-label="Play duck runner. Tap or press space to jump."
      >
        <div class="runner-hud" aria-hidden="true">
          <span data-best></span>
          <span data-score>00000</span>
        </div>
        <canvas></canvas>
        <div class="runner-over" aria-hidden="true">
          <span class="runner-final" data-final></span>
          <svg class="icon-play" viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
          <svg class="icon-retry" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12a7.5 7.5 0 1 0 2.2-5.3" /><path d="M4 4.5v3.7h3.7" /></svg>
          <span class="runner-hint">space / tap</span>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="else-h">
      <h2 id="else-h"><span aria-hidden="true">*</span> elsewhere</h2>
      <p class="about">
        Looking for the serious version? That's at <a href="/">rrreksa.com</a>, with the <a href="/#cv">CV</a>.
      </p>
    </section>
  </main>

  <footer class="foot">
    <span>© {year} reksa</span>
    <span class="foot-meta">[t] theme</span>
  </footer>
</Base>

<script>
  import { mountDither } from "../scripts/dither";
  import { mountRunner } from "../scripts/runner";
  import { mountHighlight } from "../scripts/highlight";

  mountDither();
  document.querySelectorAll<HTMLCanvasElement>("[data-highlight]").forEach(mountHighlight);
  const game = document.querySelector<HTMLElement>("[data-runner]");
  if (game) mountRunner(game);
</script>
